#!/bin/sh

# Wait for Kafka to be ready
echo "Waiting for Kafka to be ready..."
if command -v cub > /dev/null; then
  cub kafka-ready -b kafka:9092 1 120
else
  until nc -z kafka 9092; do
    echo "Waiting for Kafka..."
    sleep 2
  done
fi
echo "Kafka is ready."
# Additional wait for topics
sleep 10

# Background process to upload connector configs once Kafka Connect is ready
(
  echo "Connector Configurator: Waiting for Kafka Connect to be ready..."

  while true; do
    if curl -s -f http://localhost:8083 > /dev/null; then
      echo "Connector Configurator: Kafka Connect is up!"
      break
    fi
    echo "Connector Configurator: waiting for kafka connect..."
    sleep 10
  done

  echo "Connector Configurator: UPLOADING CONFIGS FOR CONNECTORS"
  for file in /opt/kafka-connect-configs/*; do
    if [ -f "$file" ]; then
      echo "Connector Configurator: Uploading $file"
      # Extract connector name from the JSON file
      CONNECTOR_NAME=$(cat "$file" | python -c "import sys,json; print(json.load(sys.stdin)['name'])" 2>/dev/null)
      if [ -z "$CONNECTOR_NAME" ]; then
        echo "Connector Configurator: ERROR - could not extract 'name' from $file, skipping"
        continue
      fi
      # Extract just the config object
      CONFIG=$(cat "$file" | python -c "import sys,json; print(json.dumps(json.load(sys.stdin)['config']))" 2>/dev/null)
      if [ -z "$CONFIG" ]; then
        echo "Connector Configurator: ERROR - could not extract 'config' from $file, skipping"
        continue
      fi
      # Use PUT for idempotent create-or-update
      echo "Connector Configurator: PUT /connectors/$CONNECTOR_NAME/config"
      curl -X PUT -H "Content-Type: application/json" -d "$CONFIG" "http://localhost:8083/connectors/$CONNECTOR_NAME/config"
      echo ""
    fi
  done
  echo "Connector Configurator: Done."
) &

# Execute the main Kafka Connect process
exec /etc/confluent/docker/run
