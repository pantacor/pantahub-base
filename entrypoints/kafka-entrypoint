#!/bin/sh

# Background process to create topics once Kafka is ready
(
  echo "Topic creator: Waiting for Zookeeper..."
  until nc -z zookeeper 2181; do
    sleep 2
  done

  echo "Topic creator: Waiting for Kafka to be ready..."
  # Use cub if available, otherwise just wait and try kafka-topics
  if command -v cub > /dev/null; then
    cub kafka-ready -b kafka:9092 1 60
  else
    # Fallback to waiting for the port
    until nc -z localhost 9092; do
      sleep 2
    done
  fi

  TOPICS="
pantacor-cp-kafka-connect-offset-dev
pantacor-cp-kafka-connect-config-dev
pantabase-mongo.pantabase-serv.pantahub_devices
pantabase-mongo.pantabase-serv.pantahub_trails
pantabase-mongo.pantabase-serv.pantahub_steps
ph-device-summary
ph-device-summary-short
ph-device-summary-flat
fluentd-api
"

  for n in $TOPICS
  do
    echo "Topic creator: Creating topic $n"
    kafka-topics --create --if-not-exists --zookeeper zookeeper:2181 --replication-factor=1 --partitions=1 --topic "$n"
  done
  echo "Topic creator: Done."
) &

# Execute the main Kafka process
exec /etc/confluent/docker/run